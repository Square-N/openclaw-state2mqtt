{
  "name": "openclaw-state2mqtt",
  "version": "0.5.1",
  "description": "Publish OpenClaw agent state to MQTT, with Home Assistant MQTT Discovery built in",
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "home-assistant",
    "mqtt",
    "mqtt-discovery",
    "state2mqtt",
    "agent-state"
  ],
  "files": [
    "index.js",
    "lib/",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.11.3",
      "minGatewayVersion": "2026.11.3"
    },
    "build": {
      "openclawVersion": "2026.11.3",
      "pluginSdkVersion": "2026.11.3"
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Square-N/openclaw-state2mqtt.git"
  },
  "homepage": "https://github.com/Square-N/openclaw-state2mqtt#readme",
  "bugs": {
    "url": "https://github.com/Square-N/openclaw-state2mqtt/issues"
  },
  "author": "Square-N"
}
